{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/contact-us", "destination": "/contact", "permanent": true },
    { "source": "/blogs", "destination": "/blog", "permanent": true },
    { "source": "/blogs/:slug", "destination": "/blog/:slug", "permanent": true },
    { "source": "/countries", "destination": "/study-abroad", "permanent": true },
    { "source": "/study-destinations", "destination": "/study-abroad", "permanent": true },
    { "source": "/mbbs", "destination": "/mbbs-abroad", "permanent": true },
    { "source": "/medical-abroad", "destination": "/mbbs-abroad", "permanent": true },
    { "source": "/study-in-united-kingdom", "destination": "/study-in-uk", "permanent": true },
    { "source": "/study-in-us", "destination": "/study-in-usa", "permanent": true },
    { "source": "/scholarship", "destination": "/scholarships", "permanent": true },
    { "source": "/loans", "destination": "/education-loan", "permanent": true },
    { "source": "/visa", "destination": "/student-visa", "permanent": true },
    { "source": "/exams-and-tests", "destination": "/exams", "permanent": true },
    { "source": "/events-and-webinars", "destination": "/events", "permanent": true },
    { "source": "/counselling", "destination": "/free-counselling", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/terms", "destination": "/terms-and-conditions", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "X-DNS-Prefetch-Control", "value": "on" }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(favicon.ico|favicon.svg|favicon-32.png|apple-touch-icon.png|icon-192.png|icon-512.png|og-image.jpg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(hero.mp4|hero.webm|hero-mobile.mp4|hero-poster.jpg)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(sitemap.xml|robots.txt|llms.txt|site.webmanifest|humans.txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }]
    }
  ]
}
